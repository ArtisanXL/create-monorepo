{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__DB_PREFIX__-web",
@if api
  "main": "src/worker.ts",
@endif
  "compatibility_date": "__COMPATIBILITY_DATE__",
@if api
  // Same origin as the Vite proxy gives in dev: the Worker runs first for /api/* and forwards it to
  // the api Worker. Everything else is served from assets (SPA).
  "services": [{ "binding": "API", "service": "__DB_PREFIX__-api" }],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
@endif
@if !api
  // Assets only: no Worker code, no bindings. Unknown paths fall back to index.html (SPA).
  "assets": {
    "not_found_handling": "single-page-application"
  }
@endif
}
