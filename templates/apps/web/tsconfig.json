{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
@if api
    // "node": AppType is inferred from the api source, which needs Node types.
    "types": ["vite/client", "node"]
@endif
