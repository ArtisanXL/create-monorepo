{
  "name": "__SCOPE__/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
@if node
    "dev": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env dist/worker.mjs",
    "typecheck": "tsc -p ."
@endif
@if cloudflare
    "dev": "wrangler dev --test-scheduled",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "typecheck": "wrangler types && tsc -p ."
@endif
  },
  "dependencies": {
    "__SCOPE__/core": "workspace:*",
    "__SCOPE__/db": "workspace:*",
@if node
    "pg-boss": "catalog:",
@endif
    "zod": "catalog:"
  },
@if node
  "devDependencies": { "tsdown": "catalog:", "tsx": "catalog:" }
@endif
@if cloudflare
  "devDependencies": { "wrangler": "catalog:" }
@endif
}
