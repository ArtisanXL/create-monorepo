{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__NAME_PREFIX__-api",
  "main": "src/cloudflare.ts",
  "compatibility_date": "__COMPATIBILITY_DATE__",
  "compatibility_flags": ["nodejs_compat"],
  // Fixed debugger port for a plain `wrangler dev`: left to itself, Workers started together all probe
  // from 9229 and one dies with "Address already in use". scripts/cloudflare-dev.mjs overrides it per server.
  "dev": { "inspector_port": 9230 },
  "hyperdrive": [
    {
      "binding": "__HYPERDRIVE_BINDING__",
      // Placeholder: create the Hyperdrive config yourself (`wrangler hyperdrive create`) and put its id here.
      "id": "REPLACE_WITH_YOUR_HYPERDRIVE_ID"
    }
  ]
}
