{
  "name": "@artisanxl/create-monorepo",
  "version": "0.4.0",
  "description": "Scaffold a guard-railed TypeScript monorepo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtisanXL/create-monorepo.git"
  },
  "homepage": "https://github.com/ArtisanXL/create-monorepo#readme",
  "bugs": {
    "url": "https://github.com/ArtisanXL/create-monorepo/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "create-monorepo": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check . && node scripts/lint-templates.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  }
}
